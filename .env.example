POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition
POSTGRES_DB=nutrition

CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Auth: "dev" signs every request in as DEV_USER_ID with no login screen.
# "firebase" verifies Firebase Auth ID tokens; set FIREBASE_PROJECT_ID and the NEXT_PUBLIC_FIREBASE_* values below.
AUTH_MODE=dev
DEV_USER_ID=1
FIREBASE_PROJECT_ID=

# Firebase web app config (Firebase Console > Project settings > Your apps > Web app).
# These are public values baked into the frontend at build time; all four must be set to enable the login screen.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# AI: "claude", "gemini" or "stub".
# Empty = inferred from AI_API_KEY ("sk-ant-..." -> claude, "AIza..." -> gemini), or stub without a key.
# Newer Gemini keys may not start with "AIza"; set AI_PROVIDER=gemini explicitly for those.
AI_PROVIDER=
AI_API_KEY=
# Empty = provider default (claude: claude-opus-5 / gemini: gemini-3.6-flash).
AI_MODEL=
