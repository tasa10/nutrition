POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition
POSTGRES_DB=nutrition

CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Auth: "dev" signs every request in as DEV_USER_ID (Firebase Auth to be added later).
AUTH_MODE=dev
DEV_USER_ID=1

# AI: "claude" or "stub". Empty = claude when AI_API_KEY is set, otherwise stub.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=claude-opus-5
